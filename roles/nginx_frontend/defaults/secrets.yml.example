---
# Copy to secrets.yml and encrypt with ansible-vault:
#   ansible-vault encrypt roles/nginx_frontend/defaults/secrets.yml

nginx_frontend_domain: "your-domain.com"
nginx_frontend_certbot_email: "admin@admin.com"

# Cloudflare Origin CA cert + key for dash.* and sub.* vhosts (CF-proxied).
# Generate in CF dashboard → SSL/TLS → Origin Server → Create Certificate
# (15-year validity, covers *.your-domain.com). Paste full PEM contents below.
# Required when nginx_frontend_dashboard_enabled or nginx_frontend_sub_enabled
# is true. Without these vars deploy will skip the cert copy and nginx -t
# will fail because dashboard.conf.j2 / sub.conf.j2 reference the path.
# nginx_frontend_cf_origin_cert: |
#   <full PEM certificate block>
# nginx_frontend_cf_origin_key: |
#   <full PEM private key block>
