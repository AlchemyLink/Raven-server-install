{
  "outbounds": [
    {
      "protocol": "freedom",
      {# ── Finalmask ─────────────────────────────────────────────────────── #}
      {# Finalmask is a STREAM setting, not a freedom `settings` key, and its #}
      {# lists are `tcp`/`udp` holding {type, settings} entries — see          #}
      {# infra/conf: StreamConfig.FinalMask + FinalMask{Tcp,Udp} + Mask.       #}
      {# The old `settings.finalmask.tcpmasks[].fragment` shape parsed as an   #}
      {# unknown key and was silently discarded, so no fragmentation ran.      #}
      {% set _frag = xray_freedom_fragment | default({}) %}
      {% set _noises = xray_freedom_noises | default([]) %}
      {% if _frag.packets is defined %}
      "streamSettings": {
        "finalmask": {
          "tcp": [
            {
              "type": "fragment",
              "settings": {
                "packets": "{{ _frag.packets }}",
                "length": "{{ _frag.length | default('100-200') }}",
                {# `delay`, not the legacy freedom.settings.fragment          #}
                {# `interval`; `interval` kept as an alias for old host_vars. #}
                "delay": "{{ _frag.delay | default(_frag.interval | default('10-20')) }}"
              }
            }
          ]
        }
      },
      {% endif %}
      "settings": {
        {% if _noises | length > 0 %}
        "noises": [
          {% for noise in _noises %}
          {
            "type": "{{ noise.type }}",
            "packet": "{{ noise.packet | default('') }}"{{ "," if noise.delay is defined }}
            {% if noise.delay is defined %}
            "delay": "{{ noise.delay }}"
            {% endif %}
          }{{ "," if not loop.last }}
          {% endfor %}
        ],
        {% endif %}
        "domainStrategy": "AsIs"
      },
      "tag": "freedom"
    },
    {
      "protocol": "blackhole",
      "settings": {},
      "tag": "blocked"
    }{% if xray_direct_ru_enabled | default(true) %},
    {
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      },
      "tag": "direct-ru"
    }{% endif %}
  ]
}
