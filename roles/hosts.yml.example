---
all:
  children:
    cloud:
      hosts:
        vm_my_srv:
          ansible_host: "EU_VPS_IP"   # Replace with your EU VPS IP
          ansible_port: 22
          # edge_firewall: public IPs still bound to this host that must stay silent
          # (e.g. the original IP after moving to a reserved IP). Never your ansible_host.
          # edge_firewall_blackhole_ips: ["203.0.113.10"]
      children:
        # RU host group — RU-targeted playbooks (relay, monitoring scrape, WG)
        # iterate `groups['ru']`. Adding a second RU = append a new host slot.
        ru:
          hosts:
            vm_my_ru:
              ansible_host: "RU_VPS_IP"   # Replace with your RU VPS IP
              ansible_port: 22
              wg_ip: 10.10.0.2            # WireGuard IP for this peer
              # wg_awg_enabled: true      # AmneziaWG second tunnel (awg0) to EU; also set on the EU host
              # wg_awg_ip: 10.11.0.2      # awg0 address of this peer (default wg_awg_ru_ip)
              # wg_public_key:            # Per-host (optional). Falls back to global wg_ru_public_key.
              relay_cloudflare_proxy: true
              relay_cloudflare_enforce: true
              relay_bridge_enabled: false
              relay_bridge_sni: ""
              # relay_upstream_via_wg: true  # VPN sessions → EU over wg0 (needs the wireguard role)
              # relay_haproxy_enabled: true  # local HAProxy hop with active TLS checks over every path to EU
            # Add a second RU here when scaling, e.g.:
            #
            # ⚠ If you also add the new node as a second origin A record on a
            # Cloudflare-PROXIED hostname, be aware CF's free tier round-robins
            # origins with NO health check. A node that dies by blackholing packets
            # (VPS powered off — no TCP RST) then costs a ~20 s connect timeout on
            # every request before CF retries the surviving origin: the site still
            # answers 200, just far past any client's timeout, which is much harder
            # to spot than a clean 5xx. Either pair the second origin with a real
            # reachability alert and pull its A record the moment it dies, or keep
            # exactly one origin A record per proxied hostname.
            # vm_my_ru_b:
            #   ansible_host: "SECOND_RU_VPS_IP"
            #   ansible_port: 22
            #   wg_ip: 10.10.0.4
            #   relay_cloudflare_proxy: true
            #   relay_cloudflare_enforce: true

        # Multi-node group — homogeneous Xray entry nodes provisioned by
        # role_xray_node.yml. Each node joins the WireGuard mesh (its wg_ip
        # becomes an EU peer automatically) and exposes its Xray gRPC API on that
        # wg_ip; register it in Raven-subscribe config.json as
        # nodes:[{ api_addr: "<wg_ip>:10085", ... }]. Uncomment to add a node:
        nodes:
          hosts: {}
          # vm_my_node_a:
          #   ansible_host: "NODE_VPS_IP"     # public IP of the node host
          #   ansible_port: 22
          #   wg_ip: 10.10.0.10               # this node's WireGuard address (unique in 10.10.0.0/24)
          #   wg_private_key: "NODE_WG_PRIVKEY"   # per-host; generate: wg genkey
          #   wg_public_key:  "NODE_WG_PUBKEY"    # per-host; wg pubkey < privkey (EU peers this)
      vars:
        ansible_user: deploy
        ansible_python_interpreter: /usr/bin/python3
        ansible_ssh_private_key_file: ~/.ssh/id_ed25519
        ansible_ssh_host_key_checking: false
