  - orgId: 1
    uid: tspu-rst-spike
  - orgId: 1
    uid: tspu-degradation-sustained
  - orgId: 1
    uid: dpi-handshake-spike
  - orgId: 1
    uid: dpi-probe-detected
  - orgId: 1
    uid: dpi-rst-spike
  - orgId: 1
    uid: dpi-degradation-sustained
