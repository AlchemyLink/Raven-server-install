  {
   "id": 4,
   "type": "table",
   "title": "Белые списки: оператор × округ (доля минут, %)",
   "gridPos": {
    "h": 14,
    "w": 24,
    "x": 0,
    "y": 17
   },
   "datasource": {"type": "prometheus", "uid": "{{ grafana_prometheus_datasource_uid }}"},
   "targets": [
    {
     "refId": "A",
     "expr": "last_over_time(ext_whitelist_share_pct[3h])",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "district_name",
      "rowField": "operator_name",
      "valueField": "Value"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "custom": {
      "cellOptions": {
       "type": "color-background",
       "mode": "gradient"
      },
      "align": "center"
     },
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 20
       },
       {
        "color": "orange",
        "value": 50
       },
       {
        "color": "red",
        "value": 80
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "operator_name\\district_name"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto"
        }
       },
       {
        "id": "displayName",
        "value": "Оператор"
       }
      ]
     }
    ]
   },
   "description": "Пустая ячейка = Taucloud наблюдал пару меньше 24 ч (доля не публикуется). Окно ~30 дней, обновление ~раз в сутки."
  },
  {
   "id": 5,
   "type": "table",
   "title": "IODA: регионы со сбоями за 24 ч",
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 31
   },
   "datasource": {"type": "prometheus", "uid": "{{ grafana_prometheus_datasource_uid }}"},
   "targets": [
    {
     "refId": "A",
     "expr": "sort_desc(last_over_time(ext_ioda_region_outage_score[3h]) > 0)",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "donor": true
      },
      "renameByName": {
       "region_code": "IODA code",
       "district": "Округ",
       "Value": "Score"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left"
     }
    },
    "overrides": []
   },
   "description": "Код региона IODA (NetAcuity). Пусто = за сутки сбоев не зафиксировано."
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Свежесть источников",
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 12,
    "y": 31
   },
   "datasource": {"type": "prometheus", "uid": "{{ grafana_prometheus_datasource_uid }}"},
   "targets": [
    {
     "refId": "A",
     "expr": "time() - last_over_time(ext_feed_last_success_timestamp_seconds[1d])",
     "instant": true,
     "legendFormat": "{% raw %}{{ feed }} — последний успешный сбор{% endraw %}"
    },
    {
     "refId": "B",
     "expr": "time() - last_over_time(ext_whitelist_updated_timestamp_seconds[1d])",
     "instant": true,
     "legendFormat": "Taucloud — данные обновлены"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 21600
       },
       {
        "color": "red",
        "value": 172800
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name",
    "orientation": "horizontal"
   }
  }
 ],
