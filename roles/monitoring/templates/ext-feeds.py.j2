def get(url, timeout=30):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json, text/csv"})
    with urllib.request.urlopen(req, timeout=timeout) as r:  # nosec - fixed https URLs
        return r.read()


def esc(v):
    return str(v).replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")


def line(name, labels, value, ts_ms):
    lbl = ",".join(f'{k}="{esc(v)}"' for k, v in labels.items())
    # Plain concatenation on purpose: this file is a Jinja template, so no
    # double braces and no brace-percent sequences may appear in the code.
    return name + "{" + lbl + "} " + str(value) + " " + str(ts_ms)


def taucloud(now_ms, out):
    raw = get(TAUCLOUD_URL)
    d = json.loads(raw)
    rows = d.get("rows") or []
    if not rows:
        raise ValueError("taucloud: no rows")
    for r in rows:
        dist = r.get("district")
        if dist not in DISTRICTS:
            continue
        name, lat, lon = DISTRICTS[dist]
        base = {"operator": r.get("operator", "?"), "operator_name": r.get("operator_name", ""),
                "district": dist, "district_name": name}
        out.append(line("ext_whitelist_observed_minutes", base, int(r.get("observed_minutes") or 0), now_ms))
        out.append(line("ext_whitelist_switches", base, int(r.get("switches") or 0), now_ms))
        share = r.get("share_on_pct")
        if share is not None:  # null = <24 h observed; absence, not zero
            out.append(line("ext_whitelist_share_pct", {**base, "lat": lat, "lon": lon}, float(share), now_ms))
    for key in ("updated", "window_end"):
        v = d.get(key)
        if v:
            try:
                fmt = "%Y-%m-%dT%H:%M:%S" if "T" in v else "%Y-%m-%d"
                t = time.mktime(time.strptime(v[:19], fmt))
                out.append(line(f"ext_whitelist_{key}_timestamp_seconds", {"feed": "taucloud"}, int(t), now_ms))
            except ValueError:
                pass
    return len(rows)


def ioda(now_ms, out):
    until = int(now_ms / 1000)
    url = IODA_URL.format(start=until - 86400, end=until)
    d = json.loads(get(url, timeout=60))
    if d.get("error"):
        raise ValueError(f"ioda: {d['error']}")
    scores = {}
    events = {}
    for e in d.get("data") or []:
        ent = e.get("entity") or {}
        try:
            code = int(ent.get("code"))
        except (TypeError, ValueError):
            continue
        scores[code] = float((e.get("scores") or {}).get("overall") or 0)
        events[code] = int(e.get("event_cnt") or 0)
    per_district = {k: 0.0 for k in DISTRICTS}
    # Emit every mapped region (0 when quiet) so "no outage" is distinguishable
    # from "feed broken" in Grafana.
    for code, dist in IODA_REGION_DISTRICT.items():
        rname, rlat, rlon = REGION_INFO.get(code, (str(code), 0, 0))
        lbl = {"region_code": code, "district": dist, "region_name": rname, "lat": rlat, "lon": rlon}
        out.append(line("ext_ioda_region_outage_score", lbl, scores.get(code, 0.0), now_ms))
        out.append(line("ext_ioda_region_outage_events", lbl, events.get(code, 0), now_ms))
        per_district[dist] += scores.get(code, 0.0)
    for dist, s in per_district.items():
        if dist == "krym":
            continue
        name, lat, lon = DISTRICTS[dist]
        out.append(line("ext_ioda_district_outage_score",
                        {"district": dist, "district_name": name, "lat": lat, "lon": lon}, s, now_ms))
    return len(scores)


def push(lines):
    body = ("\n".join(lines) + "\n").encode()
    req = urllib.request.Request(VM_IMPORT, data=body, method="POST")
    auth = base64.b64encode(f"{VM_USER}:{VM_PASS}".encode()).decode()
    req.add_header("Authorization", "Basic " + auth)
    req.add_header("Content-Type", "text/plain")
    with urllib.request.urlopen(req, timeout=30) as r:  # nosec - private VPC address
        if r.status // 100 != 2:
            raise RuntimeError(f"vm import HTTP {r.status}")


def main():
    now_ms = int(time.time() * 1000)
    out, rc = [], 0
    for feed, fn in (("taucloud", taucloud), ("ioda", ioda)):
        try:
            n = fn(now_ms, out)
            out.append(line("ext_feed_up", {"feed": feed}, 1, now_ms))
            out.append(line("ext_feed_last_success_timestamp_seconds", {"feed": feed}, now_ms // 1000, now_ms))
            print(f"{feed}: ok ({n} rows)")
        except (urllib.error.URLError, ValueError, KeyError, json.JSONDecodeError, OSError) as e:
            out.append(line("ext_feed_up", {"feed": feed}, 0, now_ms))
            print(f"{feed}: FAILED {e}", file=sys.stderr)
            rc = 1
    push(out)
    print(f"imported {len(out)} samples")
    return rc


if __name__ == "__main__":
    sys.exit(main())
